@@CSS
/* partnership: a two-column ledger (who, then what they bring), three steps, then the invitation.
   Motion: every .t.reveal block gets .in from the shared reveal observer; the choreography below keys off it. */
#partnership h2{text-wrap:balance}
#partnership{--gx:clamp(18px,2.6vw,40px)}
@media (min-width:1101px){#partnership .head2{grid-template-columns:minmax(0,1fr) 21rem;gap:clamp(24px,3.5vw,48px)}}

/* ledger: lines are pseudo-elements so they can draw in */
.ledger{--ls:1;--slot:96px;--pt:clamp(30px,3.4vw,44px);--px:clamp(24px,3.6vw,56px);position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.ledger::before,.ledger::after{content:"";position:absolute;left:0;right:0;height:1px;transform-origin:0 50%}
.ledger::before{top:0;background:var(--ink);z-index:1}
.ledger::after{bottom:0;background:var(--rule)}
.l-col{--b:.1s;position:relative;min-width:0;padding:var(--pt) var(--px) clamp(34px,3.6vw,48px) 0}
.l-col+.l-col{--b:.4s;padding-left:var(--px);padding-right:0}
@supports (grid-template-rows:subgrid){
  .ledger{grid-template-rows:repeat(4,auto)}
  .l-col{display:grid;grid-row:span 4;grid-template-rows:subgrid;row-gap:0}
  .l-logos{grid-row:1}
  .l-cap{grid-row:2}
  .l-col h3{grid-row:3}
  .l-col .dash{grid-row:4}
}
/* divider (vertical) and the plus on it, level with the logos */
.l-col+.l-col::after{content:"";position:absolute;left:0;top:0;bottom:0;width:1px;background:var(--rule);transform-origin:50% 0}
.l-col+.l-col::before{content:"";position:absolute;z-index:1;left:0;top:calc(var(--pt) + var(--slot)/2);width:38px;height:38px;translate:-50% -50%;background:linear-gradient(var(--saffron),var(--saffron)) center/16px 2px no-repeat,linear-gradient(var(--saffron),var(--saffron)) center/2px 16px no-repeat,var(--paper)}
/* logos: tight-cropped files with different proportions, sized to a similar optical area and centred in one slot */
.l-logos{--d:var(--b);display:flex;align-items:center;gap:clamp(16px,2vw,24px);height:var(--slot)}
.l-logos img{flex:none;width:auto;max-width:none}
.lg-a{height:calc(58px*var(--ls))}
.lg-g{height:calc(68px*var(--ls))}
.lg-i{height:calc(60px*var(--ls))}
.l-logos span{flex:none;width:1px;height:calc(46px*var(--ls));background:var(--rule)}
.l-cap{--d:calc(var(--b) + .1s);margin:0 0 24px;font-size:13.5px;line-height:1.45;color:var(--muted)}
.l-col h3{--d:calc(var(--b) + .18s);margin:0 0 20px;font:500 clamp(25px,2.5vw,34px)/1.12 var(--serif);letter-spacing:-.012em;text-wrap:balance}
.dash{position:relative}
.dash li{--dy:12px;--d:calc(var(--b) + .32s + var(--j,0)*.09s);position:relative;padding:10px 0 10px 24px;font-size:15.5px;font-weight:500;line-height:1.45}
.dash li:nth-child(2){--j:1}
.dash li::after{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule);transform-origin:0 50%}
.dash::after{content:"";display:block;height:1px;background:var(--rule);transform-origin:0 50%}
.dash li::before{content:"";position:absolute;left:0;top:1.35em;width:12px;height:2px;background:var(--saffron);transform-origin:0 50%}
/* what the platform will do */
.does{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:var(--gx);align-items:start;margin-top:clamp(48px,6vw,80px)}
.does .mini{position:relative;margin:0;padding-top:17px;color:var(--ink)}
.does .mini::before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule);transform-origin:0 50%}
.does ol{grid-column:2/-1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:var(--gx);counter-reset:d}
.does li{--k:0;counter-increment:d;position:relative;padding-top:16px;font:500 clamp(19px,1.6vw,23px)/1.28 var(--serif);letter-spacing:-.005em;text-wrap:pretty}
.does li:nth-child(2){--k:1}
.does li:nth-child(3){--k:2}
.does li::after{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:var(--ink);transform-origin:0 50%}
.does li::before{content:"0" counter(d);content:"0" counter(d) / "";display:block;margin-bottom:12px;font:700 11.5px/1 var(--sans);letter-spacing:.14em;color:var(--saffron-t);font-variant-numeric:lining-nums tabular-nums}
.does li>span{display:block}
/* invitation */
.invite{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:26px clamp(32px,5vw,72px);align-items:end;margin-top:clamp(56px,7vw,96px);padding-top:clamp(28px,3.4vw,40px)}
.invite::before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule);transform-origin:0 50%}
.invite p{--d:.14s;margin:0;max-width:24em;font:500 clamp(26px,2.6vw,37px)/1.18 var(--serif);letter-spacing:-.015em;text-wrap:balance}
.inv-cta{--d:.42s}
.invite .btn:focus-visible{background:var(--forest2)}
.invite .btn:focus-visible .ico{transform:translateX(4px)}
.invite .btn:active{transform:scale(.97);transition-duration:.12s}
@media (max-width:900px){
  .does{grid-template-columns:1fr;row-gap:20px}
  .does .mini{padding-top:0}
  .does .mini::before{display:none}
  .does ol{grid-column:1;grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (max-width:760px){
  .ledger{grid-template-columns:1fr}
  .l-col,.l-col+.l-col{--b:.1s;display:block;grid-row:auto;padding:var(--pt) 0 34px}
  .l-col+.l-col::after{left:0;right:0;bottom:auto;width:auto;height:1px;transform-origin:0 50%}
  .l-col+.l-col::before{left:0;top:0;translate:0 -50%}
  .l-logos,.l-cap,.l-col h3,.l-col .dash{grid-row:auto}
  .l-cap{margin-bottom:22px}
  .invite{grid-template-columns:1fr}
}
@media (max-width:700px){
  .does ol{grid-template-columns:1fr;row-gap:26px}
  .does li:nth-child(n){--k:0}
  .invite .btn{width:100%;justify-content:center}
}
@media (max-width:420px){
  .ledger{--ls:.8;--slot:74px}
}

/* ---- motion: nothing is hidden unless JS is on and motion is allowed ---- */
.js .t.reveal{opacity:1;transform:none;transition:none}
@media (prefers-reduced-motion:no-preference){
  .js .l-col:not(.in) .l-logos,.js .l-col:not(.in) .l-cap,.js .l-col:not(.in) h3,.js .l-col:not(.in) .dash li,
  .js .does .mini:not(.in) .pa,.js .invite:not(.in) .pa{opacity:0;transform:translateY(var(--dy,22px))}
  .js .ledger:not(.in)::before,.js .ledger:not(.in)::after,
  .js .l-col:not(.in) .dash::after,.js .l-col:not(.in) .dash li::after,.js .l-col:not(.in) .dash li::before,
  .js .does .mini:not(.in)::before,.js .does li:not(.in)::after,.js .invite:not(.in)::before{transform:scaleX(0)}
  .js .l-col+.l-col:not(.in)::after{transform:scaleY(0)}
  .js .l-col+.l-col:not(.in)::before{opacity:0;scale:.3;rotate:-90deg}
  .js .does li:not(.in)::before,.js .does li:not(.in)>span{opacity:0;transform:translateY(16px)}

  /* ledger: top rule draws, the left column rises, then the divider, the plus and the right column; rows arrive one by one */
  .ledger.in::before{transition:transform 1.3s var(--ease)}
  .ledger.in::after{transition:transform 1.2s var(--ease) 1.1s}
  .l-col.in .l-logos,.l-col.in .l-cap,.l-col.in h3,.l-col.in .dash li{transition:opacity .9s var(--ease) var(--d),transform .9s var(--ease) var(--d)}
  .l-col.in .dash li::after{transition:transform .9s var(--ease) var(--d)}
  .l-col.in .dash li::before{transition:transform .6s var(--ease) calc(var(--d) + .25s)}
  .l-col.in .dash::after{transition:transform .9s var(--ease) calc(var(--b) + .5s)}
  .l-col+.l-col.in::after{transition:transform 1.2s var(--ease) .2s}
  .l-col+.l-col.in::before{transition:opacity .5s var(--ease) .55s,scale .9s var(--ease) .55s,rotate .9s var(--ease) .55s}
  /* steps: each rule draws, then its number and sentence follow */
  .does .mini.in::before{transition:transform 1s var(--ease)}
  .does .mini.in .pa{transition:opacity .8s var(--ease) .2s,transform .8s var(--ease) .2s}
  .does li.in::after{transition:transform 1s var(--ease) calc(.08s + var(--k)*.12s)}
  .does li.in::before{transition:opacity .8s var(--ease) calc(.3s + var(--k)*.12s),transform .8s var(--ease) calc(.3s + var(--k)*.12s)}
  .does li.in>span{transition:opacity .8s var(--ease) calc(.4s + var(--k)*.12s),transform .8s var(--ease) calc(.4s + var(--k)*.12s)}
  /* invitation: rule, then the sentence, then the button */
  .invite.in::before{transition:transform 1.2s var(--ease)}
  .invite.in .pa{transition:opacity .9s var(--ease) var(--d),transform .9s var(--ease) var(--d)}
}
@media (prefers-reduced-motion:no-preference) and (max-width:760px){
  .js .l-col+.l-col:not(.in)::after{transform:scaleX(0)}
}
@media print{
  .js .ledger::before,.js .ledger::after,.js .l-col::after,.js .l-col .dash::after,.js .l-col .dash li::before,.js .l-col .dash li::after,
  .js .does .mini::before,.js .does li::after,.js .invite::before{transform:none!important}
  .js .l-col::before{opacity:1!important;scale:1!important;rotate:0deg!important}
  .js .l-logos,.js .l-cap,.js .l-col h3,.js .dash li,.js .does .pa,.js .does li::before,.js .does li>span,.js .invite .pa{opacity:1!important;transform:none!important}
}
@media (forced-colors:active){
  .ledger::before,.ledger::after,.l-col+.l-col::after,.dash li::after,.dash::after,.does .mini::before,.does li::after,.invite::before,.l-logos span{background-color:CanvasText}
  .dash li::before{background-color:Highlight}
  .l-col+.l-col::before{background:Canvas;content:"+" / "";display:grid;place-items:center;font:400 30px/1 var(--sans);color:CanvasText}
}
@media (prefers-reduced-motion:reduce){
  .invite .btn:active{transform:none}
}
@@HTML
<section class="sec paper" id="partnership">
  <div class="wrap">
    <div class="sh reveal"><b>03</b><span>Anthill Ventures &amp; II2W</span></div>
    <div class="head2">
      <h2>Turning agricultural innovation into commercial growth in India</h2>
      <p class="lead reveal" style="--d:.35s">Anthill Ventures and II2W are developing a joint AgriTech investment and company-building platform.</p>
    </div>
    <div class="ledger t reveal">
      <article class="l-col t reveal">
        <div class="l-logos"><img class="lg-a" src="{{LOGO0}}" alt="Anthill Ventures"></div>
        <h3>A decade of investment and Speed Scaling experience</h3>
        <ul class="dash" role="list">
          <li>The Speed Scaling model</li>
          <li>A market access network across growers, agribusinesses and distributors</li>
        </ul>
      </article>
      <article class="l-col t reveal">
        <div class="l-logos"><img class="lg-g" src="{{LOGO1}}" alt="Green Road Innovation"><span aria-hidden="true"></span><img class="lg-i" src="{{LOGO2}}" alt="II2W Indo-Israel Agro World"></div>
        <p class="l-cap">II2W is Green Road Innovation’s investment initiative.</p>
        <h3>Agricultural expertise and project execution</h3>
        <ul class="dash" role="list">
          <li>Access to Israeli innovation</li>
          <li>Operational presence in Israel and India</li>
        </ul>
      </article>
    </div>
    <div class="does">
      <h3 class="mini t reveal"><span class="pa">Together, the partners aim to</span></h3>
      <ol role="list">
        <li class="t reveal"><span>Identify promising technologies</span></li>
        <li class="t reveal"><span>Validate their performance under local farming conditions</span></li>
        <li class="t reveal"><span>Support commercialization through capital, project execution and strategic partnerships</span></li>
      </ol>
    </div>
    <div class="invite t reveal">
      <p class="pa">We invite qualified investors, fund managers and family offices to join us in bringing agricultural innovation to scale in India.</p>
      <div class="inv-cta pa"><a class="btn" href="#contact">Request an investor conversation <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-arrow"/></svg></a></div>
    </div>
  </div>
</section>
@@JS
  /* Failsafe: if IntersectionObserver exists but never calls back, show this page's revealed content anyway. */
  (function(){
    if(reduce||!('IntersectionObserver' in window))return;
    var alive=false,probe;
    try{probe=new IntersectionObserver(function(){alive=true;probe.disconnect();});probe.observe(document.body);}catch(e){}
    setTimeout(function(){
      if(alive)return;
      $('#partnership .reveal,#partnership .sh,#partnership .split,#model .reveal,#model .sh,#model .split').forEach(function(el){el.classList.add('in');});
    },4000);
  })();
