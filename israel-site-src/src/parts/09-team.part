@@CSS
/* team: editorial directory. Hairline-ruled entries, no boxes.
   Motion: the roster draws itself. Group rules draw left to right (one per column), then each entry
   assembles in reading order: rule, portrait, name, figure (rises out of a mask), facts row by row, footer.
   Hidden start states exist only under .js and prefers-reduced-motion:no-preference. */
.team-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:clamp(28px,3.8vw,56px);align-items:start}
.tgroup,.tg-stack{display:contents}
.tgroup:nth-child(1){--gd:0s}
.tgroup:nth-child(2){--gd:.1s}
.tgroup:nth-child(3){--gd:.2s}
.tgroup:nth-child(1)>.tg-h,.tgroup:nth-child(1) .member{grid-column:1}
.tgroup:nth-child(2)>.tg-h,.tgroup:nth-child(2) .member{grid-column:2}
.tgroup:nth-child(3)>.tg-h,.tgroup:nth-child(3) .member{grid-column:3}
.tg-h{--d:var(--gd,0s);position:relative;grid-row:1;margin:0;padding:16px 0 18px;font:700 11.5px/1.3 var(--sans);letter-spacing:.16em;text-transform:uppercase}
.tg-h::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:var(--ink)}
.tg-t{display:inline-block}
.tgroup .member:nth-child(1){grid-row:2;--d:calc(var(--gd,0s) + .3s)}
.tgroup .member:nth-child(2){grid-row:3;--d:calc(var(--gd,0s) + .4s)}

.member{--mpt:26px;display:flex;flex-direction:column;min-width:0;padding:var(--mpt) 0 26px}

/* entry head: portrait, name, role. The entry's top rule lives on .m-top so it can draw. */
.m-top{position:relative;display:flex;align-items:flex-start;gap:20px;padding-bottom:24px}
.m-top::before,.m-top::after{content:"";position:absolute;left:0;right:0;top:calc(var(--mpt)*-1);height:1px}
.m-top::before{background:var(--rule)}
.m-top::after{background:var(--ink);transform:scaleX(0);transform-origin:0 50%;transition:transform .7s var(--ease)}
.member.open .m-top::after{transform:none}
@media (hover:hover){.member:hover .m-top::after{transform:none}}
.member:has(:focus-visible) .m-top::after{transform:none}
.m-top>div{min-width:0;padding-top:2px}
/* small rectangular photographs, not avatars; the sources are small crops so they stay at 96x120 */
.m-top img{flex:none;width:96px;height:120px;border-radius:2px;object-fit:cover;object-position:center top;outline:1px solid rgba(18,32,26,.14);outline-offset:-1px;filter:grayscale(1) contrast(1.05);transition:filter .6s var(--ease)}
.member:hover .m-top img,.member:focus-within .m-top img,.member.open .m-top img{filter:none}
.member h4{margin:0 0 6px;font:500 26px/1.1 var(--serif);letter-spacing:-.015em}
.role{color:var(--saffron-t);font-size:13px;font-weight:700;line-height:1.4}

.m-stat{display:flex;align-items:baseline;gap:14px;margin:0;padding:0 0 18px;overflow:hidden}
.m-stat b{flex:none;font:500 32px/1 var(--serif);letter-spacing:-.025em;color:var(--forest);font-variant-numeric:lining-nums tabular-nums;font-feature-settings:"lnum","tnum"}
.m-stat span{font-size:13.5px;font-weight:600;line-height:1.35;color:var(--muted);max-width:22ch}

.facts{display:grid;gap:10px;padding-bottom:20px}
.facts li{position:relative;padding-left:20px;font-size:15px;line-height:1.5}
.facts li:nth-child(2){--i:1}
.facts li:nth-child(3){--i:2}
.facts li::before{content:"";position:absolute;left:0;top:.8em;width:10px;height:2px;background:var(--saffron);transform-origin:0 50%}

.m-foot{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px}
.m-foot::before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule);transform-origin:0 50%}
.more{display:none;align-items:center;gap:10px;min-height:44px;padding:0;background:none;border:0;font-size:14px;font-weight:700;color:var(--forest);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:color .25s}
.js .more{display:inline-flex}
.more:hover,.more:focus-visible{color:var(--saffron-t)}
.more>span:first-child{padding-bottom:3px;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .35s var(--ease)}
.more:hover>span:first-child,.more:focus-visible>span:first-child{background-size:100% 1px}
.pm{position:relative;flex:none;width:11px;height:11px}
.pm::before,.pm::after{content:"";position:absolute;left:0;right:0;top:50%;height:1.5px;margin-top:-.75px;background:currentColor;transition:transform .4s var(--ease)}
.pm::after{transform:rotate(90deg)}
.member.open .pm::after{transform:rotate(0)}
.in-btn{display:inline-flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;margin:0 -12px 0 auto;color:var(--muted);border-radius:8px;transition:color .25s,transform .35s var(--ease)}
.in-btn svg{width:20px;height:20px}
.in-btn:hover,.in-btn:focus-visible{color:var(--forest);transform:translate(2px,-2px)}

/* bio: the row opens (grid-template-rows 0fr to 1fr) while the text eases in a beat later; closing is quicker */
.bio{display:block}
.bio p{margin:0;padding:6px 0 4px;font-size:14.5px;line-height:1.7;color:var(--ink)}
.js .bio{display:grid;grid-template-rows:0fr;transition:grid-template-rows .55s var(--ease)}
.js .bio>div{min-height:0;overflow:hidden;visibility:hidden;transition:visibility 0s .55s}
.js .bio p{opacity:0;transform:translateY(-10px);transition:opacity .25s var(--ease),transform .25s var(--ease)}
.js .member.open .bio{grid-template-rows:1fr}
.js .member.open .bio>div{visibility:visible;transition-delay:0s}
.js .member.open .bio p{opacity:1;transform:none;transition:opacity .6s var(--ease) .15s,transform .6s var(--ease) .15s}

/* entrance choreography */
@media (prefers-reduced-motion:no-preference){
  /* the entry as a whole stays put; its parts arrive one after another */
  .js .member.reveal,.js .tg-h.reveal{opacity:1;transform:none;transition:none}
  .js .tg-h::before{transform:scaleX(0);transform-origin:0 50%;transition:transform 1.2s var(--ease) var(--d,0s)}
  .js .tg-h.in::before{transform:none}
  .js .tg-t{opacity:0;transform:translateY(10px);transition:opacity .8s var(--ease) calc(var(--d,0s) + .25s),transform .8s var(--ease) calc(var(--d,0s) + .25s)}
  .js .tg-h.in .tg-t{opacity:1;transform:none}

  .js .m-top::before{transform:scaleX(0);transform-origin:0 50%;transition:transform 1.1s var(--ease) var(--d,0s)}
  .js .member.in .m-top::before{transform:none}
  .js .m-top img{clip-path:inset(0 0 100% 0);transition:clip-path 1.1s var(--ease) calc(var(--d,0s) + .1s),filter .6s var(--ease)}
  .js .member.in .m-top img{clip-path:inset(0)}
  .js .m-top>div{opacity:0;transform:translateY(14px);transition:opacity .8s var(--ease) calc(var(--d,0s) + .2s),transform .8s var(--ease) calc(var(--d,0s) + .2s)}
  .js .member.in .m-top>div{opacity:1;transform:none}

  .js .m-stat b{transform:translateY(140%);transition:transform 1s var(--ease) calc(var(--d,0s) + .34s)}
  .js .m-stat span{opacity:0;transition:opacity .8s var(--ease) calc(var(--d,0s) + .66s)}
  .js .member.in .m-stat b{transform:none}
  .js .member.in .m-stat span{opacity:1}

  .js .facts li{opacity:0;transform:translateY(12px);transition:opacity .8s var(--ease) calc(var(--d,0s) + .5s + var(--i,0)*.08s),transform .8s var(--ease) calc(var(--d,0s) + .5s + var(--i,0)*.08s)}
  .js .facts li::before{transform:scaleX(0);transition:transform .6s var(--ease) calc(var(--d,0s) + .64s + var(--i,0)*.08s)}
  .js .member.in .facts li{opacity:1;transform:none}
  .js .member.in .facts li::before{transform:none}

  .js .m-foot::before{transform:scaleX(0);transition:transform 1s var(--ease) calc(var(--d,0s) + .78s)}
  .js .member.in .m-foot::before{transform:none}
  .js .m-foot>.more,.js .m-foot>.in-btn{opacity:0}
  .js .member.in .m-foot>.more,.js .member.in .m-foot>.in-btn{opacity:1}
  .js .m-foot>.more{transition:opacity .7s var(--ease) calc(var(--d,0s) + .92s),color .25s}
  .js .m-foot>.in-btn{transition:opacity .7s var(--ease) calc(var(--d,0s) + .98s),color .25s,transform .35s var(--ease)}
  /* a control that has keyboard focus is never left invisible mid-reveal */
  .js .m-foot>.more:focus-visible,.js .m-foot>.in-btn:focus-visible{opacity:1!important;transition:none}
}

/* tablet and phone: groups stack, two columns of entries, then one */
@media (max-width:1100px){
  .team-groups{display:block}
  .team-groups .tgroup{--gd:0s;display:block;margin-bottom:clamp(40px,6vw,60px)}
  .tgroup:last-child{margin-bottom:0}
  .tg-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(28px,5vw,56px);align-items:start}
  .tgroup>.tg-h,.tgroup .member{grid-column:auto!important;grid-row:auto!important}
  .tgroup .member:nth-child(1){--d:.3s}
  .tgroup .member:nth-child(2){--d:.4s}
}
@media (max-width:700px){
  .tg-stack{grid-template-columns:minmax(0,1fr)}
  .tgroup{margin-bottom:44px}
  .m-top img{width:88px;height:110px}
  .m-top{gap:18px}
  .member{--mpt:24px;padding:var(--mpt) 0 12px}
  .member h4{font-size:25px}
  .tgroup .member:last-child{padding-bottom:0}
  .tgroup .member:nth-child(2){--d:0s}
}

/* line the rows up across columns where subgrid exists: portrait, figure, facts, toggle, bio */
@supports (grid-template-rows:subgrid){
  @media (min-width:1101px){
    .tgroup .member:nth-child(1){grid-row:2/span 5}
    .tgroup .member:nth-child(2){grid-row:7/span 5}
    .member{display:grid;grid-template-rows:subgrid;row-gap:0}
  }
  @media (min-width:701px) and (max-width:1100px){
    .tg-stack{grid-template-rows:repeat(5,auto)}
    .tgroup .member{display:grid;grid-template-rows:subgrid;grid-row:span 5!important;row-gap:0}
  }
}

@media (hover:none){
  .m-top img{filter:none}
}
@media (prefers-reduced-motion:reduce){
  .js .bio,.js .bio>div,.js .bio p,.pm::before,.pm::after,.m-top img,.m-top::after,.more,.more>span:first-child,.in-btn{transition:none}
  .js .member.open .bio p{transition:none}
  .in-btn:hover,.in-btn:focus-visible{transform:none}
}
/* Windows High Contrast: hairlines and the plus/minus are built from backgrounds, which the system would blank out */
@media (forced-colors:active){
  .pm::before,.pm::after,.tg-h::before,.m-top::before,.m-top::after,.m-foot::before,.facts li::before{background-color:CanvasText}
}
@media print{
  .js .bio{grid-template-rows:1fr}
  .js .bio>div{visibility:visible}
  .js .bio p{opacity:1;transform:none}
  .more{display:none!important}
  .js .tg-h::before,.js .m-top::before,.js .m-foot::before,.js .facts li::before{transform:none!important}
  .js .m-top img{clip-path:none!important}
  .js .tg-t,.js .m-top img,.js .m-top>div,.js .m-stat b,.js .m-stat span,.js .facts li,.js .m-foot>.in-btn{opacity:1!important;transform:none!important}
}
@@HTML
<section class="sec paper2" id="team">
  <div class="wrap">
    <div class="sh reveal"><b>08</b><span>Israel and India</span></div>
    <div class="head2 reveal">
      <h2>Meet the management team</h2>
      <p class="lead">Investors, operators and advisers across both countries.</p>
    </div>
    <div class="team-groups">
      <div class="tgroup">
        <h3 class="tg-h reveal"><span class="tg-t">Anthill Ventures</span></h3>
        <div class="tg-stack">
      <article class="member reveal">
        <div class="m-top"><img src="{{PH_PRASAD}}" alt="" loading="lazy" width="96" height="120"><div><h4>Prasad Vanga</h4><div class="role">Founder and CEO · Anthill Ventures</div></div></div>
        <p class="m-stat"><b>80+</b><span>startups backed as an investor</span></p>
        <ul class="facts"><li>20 years helping organizations such as Nike, Nestle, Novartis and Google drive business transformations</li><li>Part of the sales management team that transformed GE Capital International Services into GENPACT</li><li>Startups backed include Zenoti, Medplus and Tynker, which provided exits of &gt;20X</li></ul>
        <div class="m-foot"><button class="more" type="button" aria-expanded="false" aria-controls="bio-prasad"><span>Full bio</span><span class="sr-only"> of Prasad Vanga</span><span class="pm" aria-hidden="true"></span></button><a class="in-btn" href="https://www.linkedin.com/in/prasadvanga/" target="_blank" rel="noopener" aria-label="Prasad Vanga on LinkedIn (opens in a new tab)" title="Prasad Vanga on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></div>
        <div class="bio" id="bio-prasad"><div><p>Prasad Vanga leads global strategy, fund management &amp; venture building at Anthill. Under his guidance, Anthill has scaled at a 5.4x multiple in just 10 years. He comes with 20 years of experience in helping organizations such as Nike, Nestle, Novartis, and Google to drive business transformations and he was part of the sales management team that transformed the captive GE Capital International Services to GENPACT, he was in the midst of scaling the company from 28000 to 75000 employees and getting listed on the NYSE with a single ticker symbol “G” and driving a value of $8B over 7 years. As an Investor, he has backed 80+ successful startups including Zenoti (Unicorn), Medplus (IPO) and Tynker (acquired by Byju’s) that provided exits of &gt;20X. He was also a board advisor to Indian School of Business in the SRITNE research division and an active alumni of the Stanford Business School.</p></div></div>
      </article>
      <article class="member reveal">
        <div class="m-top"><img src="{{PH_SAILESH}}" alt="" loading="lazy" width="96" height="120"><div><h4>Sailesh Sigatapu</h4><div class="role">General Partner · Anthill Ventures</div></div></div>
        <p class="m-stat"><b>20+</b><span>years across industries and countries</span></p>
        <ul class="facts"><li>Manages fundraising and investor relations from Indian family offices</li><li>Oversees the Urban Tech vertical and the accelerator programs</li><li>Early investor in Dhruva, a space-tech firm</li></ul>
        <div class="m-foot"><button class="more" type="button" aria-expanded="false" aria-controls="bio-sailesh"><span>Full bio</span><span class="sr-only"> of Sailesh Sigatapu</span><span class="pm" aria-hidden="true"></span></button><a class="in-btn" href="https://www.linkedin.com/in/saileshs/" target="_blank" rel="noopener" aria-label="Sailesh Sigatapu on LinkedIn (opens in a new tab)" title="Sailesh Sigatapu on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></div>
        <div class="bio" id="bio-sailesh"><div><p>Sailesh Sigatapu currently manages fundraising and investor relations from Indian family offices and oversees Anthill Venture’s Urban Tech vertical and its accelerator programs. With over two decades of experience across a spectrum of industries and different countries, Sailesh lends his expertise in sustainability and green building technology to condition relations with investors and expand their business footprint. His expertise stems from running a very successful tech services company in the US and then being an early investor in India’s leading Space-tech firm, Dhruva and also backing Concu, a leading urban lifestyle café and restaurant chain.</p></div></div>
      </article>
        </div>
      </div>
      <div class="tgroup">
        <h3 class="tg-h reveal"><span class="tg-t">Green Road Innovation</span></h3>
        <div class="tg-stack">
      <article class="member reveal">
        <div class="m-top"><img src="{{PH_BEN}}" alt="" loading="lazy" width="96" height="120"><div><h4>Ben Friedman</h4><div class="role">Co-Founder and Managing Partner · Green Road Innovation</div></div></div>
        <p class="m-stat"><b>25+</b><span>years of executive and board experience</span></p>
        <ul class="facts"><li>Connects Israeli technologies with Indian growers, investors and partners</li><li>Co-founded Hargol FoodTech and Nature Growth</li><li>Master of Science, New York University</li></ul>
        <div class="m-foot"><button class="more" type="button" aria-expanded="false" aria-controls="bio-ben"><span>Full bio</span><span class="sr-only"> of Ben Friedman</span><span class="pm" aria-hidden="true"></span></button><a class="in-btn" href="https://www.linkedin.com/in/ben-friedman-a2b14a49/" target="_blank" rel="noopener" aria-label="Ben Friedman on LinkedIn (opens in a new tab)" title="Ben Friedman on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></div>
        <div class="bio" id="bio-ben"><div><p>Ben is an agriculture, food and nutrition entrepreneur with over 25 years of executive and board experience. At Green Road Innovation, he connects Israeli technologies with Indian growers, investors and strategic partners, leading business development and market entry. He co-founded Hargol FoodTech and Nature Growth and holds a Master of Science from New York University.</p></div></div>
      </article>
      <article class="member reveal">
        <div class="m-top"><img src="{{PH_SHAFRIR}}" alt="" loading="lazy" width="96" height="120"><div><h4>Shafrir Godel</h4><div class="role">Co-Founder and Managing Partner · Green Road Innovation</div></div></div>
        <p class="m-stat"><b>30+</b><span>years in agricultural consulting</span></p>
        <ul class="facts"><li>Founder and CEO of Agriquality</li><li>Has worked with growers, AgriTech companies, research institutes and government agencies</li><li>Supports technology validation and commercial projects in Israel and India</li></ul>
        <div class="m-foot"><button class="more" type="button" aria-expanded="false" aria-controls="bio-shafrir"><span>Full bio</span><span class="sr-only"> of Shafrir Godel</span><span class="pm" aria-hidden="true"></span></button><a class="in-btn" href="https://www.linkedin.com/in/shafrirgodel/" target="_blank" rel="noopener" aria-label="Shafrir Godel on LinkedIn (opens in a new tab)" title="Shafrir Godel on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></div>
        <div class="bio" id="bio-shafrir"><div><p>Shafrir brings over three decades of experience in agricultural consulting, business development and project management. As Founder and CEO of Agriquality, he has worked with growers, AgriTech companies, research institutes and government agencies. At Green Road Innovation, he combines agricultural expertise with hands-on execution to support technology validation and commercial projects in Israel and India.</p></div></div>
      </article>
        </div>
      </div>
      <div class="tgroup">
        <h3 class="tg-h reveal"><span class="tg-t">Anthill Ventures Israel</span></h3>
        <div class="tg-stack">
      <article class="member reveal">
        <div class="m-top"><img src="{{PH_AHARON}}" alt="" loading="lazy" width="96" height="120"><div><h4>Aharon Schwartz</h4><div class="role">Venture Partner · Anthill Ventures Israel</div></div></div>
        <p class="m-stat"><b>30+</b><span>years in cross-border transactions</span></p>
        <ul class="facts"><li>International business and legal adviser</li><li>Partnered with Anthill in 2019 to establish Anthill Ventures Israel</li><li>Supports partnerships from first engagement to execution</li></ul>
        <div class="m-foot"><button class="more" type="button" aria-expanded="false" aria-controls="bio-aharon"><span>Full bio</span><span class="sr-only"> of Aharon Schwartz</span><span class="pm" aria-hidden="true"></span></button><a class="in-btn" href="https://www.linkedin.com/in/aharon-schwartz-05363939/" target="_blank" rel="noopener" aria-label="Aharon Schwartz on LinkedIn (opens in a new tab)" title="Aharon Schwartz on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></div>
        <div class="bio" id="bio-aharon"><div><p>Aharon is an international business and legal adviser with over three decades of experience in cross-border transactions, investment and joint ventures. He partnered with Anthill in 2019 to establish Anthill Ventures Israel, connecting Israeli companies with global investment and commercial opportunities. He supports partnerships from initial engagement through negotiation and execution.</p></div></div>
      </article>
      <article class="member reveal">
        <div class="m-top"><img src="{{PH_MOSHE}}" alt="" loading="lazy" width="96" height="120"><div><h4>Moshe Sharabani</h4><div class="role">Venture Partner · Anthill Ventures Israel</div></div></div>
        <p class="m-stat"><b>40+</b><span>years in operations and venture finance</span></p>
        <ul class="facts"><li>Strategic financial planning, risk management and capital solutions for new and established businesses</li><li>Expertise in credit structuring</li><li>Investments across several industries</li></ul>
        <div class="m-foot"><button class="more" type="button" aria-expanded="false" aria-controls="bio-moshe"><span>Full bio</span><span class="sr-only"> of Moshe Sharabani</span><span class="pm" aria-hidden="true"></span></button><a class="in-btn" href="https://www.linkedin.com/search/results/people/?keywords=Moshe%20Sharabani" target="_blank" rel="noopener" aria-label="Moshe Sharabani on LinkedIn (opens in a new tab)" title="Moshe Sharabani on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></div>
        <div class="bio" id="bio-moshe"><div><p>Moshe brings over four decades of experience in business operations, venture financing and credit structuring. His expertise includes strategic financial planning, risk management and capital solutions for new and established businesses. His investments span several industries, providing broad commercial experience to support venture development.</p></div></div>
      </article>
        </div>
      </div>
    </div>
  </div>
</section>
@@JS
  /* Team bios: the button label stays "Full bio"; state lives in aria-expanded and the plus turns to a minus */
  $('.member').forEach(function(m){
    /* keyboard arrival reveals the whole entry at once */
    m.addEventListener('focusin',function(){m.classList.add('in');});
    var b=m.querySelector('.more');if(!b)return;
    b.addEventListener('click',function(){
      var open=m.classList.toggle('open');
      b.setAttribute('aria-expanded',open?'true':'false');
    });
  });
  /* Safety: if the reveal observer has not fired for something already on screen after 3.5s, show it */
  setTimeout(function(){
    $('.member.reveal,.tg-h.reveal,.contact-card.reveal').forEach(function(el){
      if(el.classList.contains('in'))return;
      var r=el.getBoundingClientRect();
      if(r.bottom>0&&r.top<window.innerHeight)el.classList.add('in');
    });
  },3500);
